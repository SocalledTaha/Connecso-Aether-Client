<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:gravity="center_vertical"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/notification_compact_country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:textDirection="ltr"
            android:textSize="18sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/notification_compact_upload"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textDirection="ltr"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/notification_compact_download"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textDirection="ltr"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/notification_compact_ping"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textDirection="ltr"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/notification_compact_ping_button"
        android:layout_width="32dp"
        android:layout_height="36dp"
        android:clickable="true"
        android:contentDescription="@string/notification_ping"
        android:focusable="true"
        android:padding="6dp" />
    <ImageView
        android:id="@+id/notification_compact_disconnect_button"
        android:layout_width="32dp"
        android:layout_height="36dp"
        android:clickable="true"
        android:contentDescription="@string/notification_disconnect"
        android:focusable="true"
        android:padding="6dp" />
</LinearLayout>
