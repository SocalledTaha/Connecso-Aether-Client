<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        System notification and Quick Settings icons have fixed platform bounds.
        The source mark leaves generous transparent margins; extend its drawing
        bounds so the exact same silhouette reads at the platform's native size.
    -->
    <item
        android:left="-5dp"
        android:top="-5dp"
        android:right="-5dp"
        android:bottom="-5dp">
        <bitmap
            android:src="@drawable/connecso_notification_mark"
            android:gravity="fill" />
    </item>
</layer-list>
